{
  "name": "share-port",
  "version": "2.0.0",
  "description": "SHARE PORT - Zero-Config Localhost Tunneling & API Testing Suite",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:react": "vite",
    "build": "vite build && node scripts/postbuild.cjs",
    "webview2:build": "powershell -ExecutionPolicy Bypass -File webview2/scripts/build.ps1",
    "webview2:package": "powershell -ExecutionPolicy Bypass -File webview2/scripts/package_msix.ps1",
    "webview2:start": "powershell -ExecutionPolicy Bypass -Command \"Start-Process webview2\\bin\\SHARE-PORT.exe\"",
    "webview2:dev": "concurrently -k \"npm run dev:react\" \"powershell -ExecutionPolicy Bypass -Command wait-on tcp:5173; Start-Process webview2\\bin\\SHARE-PORT.exe -ArgumentList '--dev'\"",
    "package:msix": "powershell -ExecutionPolicy Bypass -File build_msix.ps1",
    "electron:dev": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:react\" \"npm run electron:dev\"",
    "start": "powershell -ExecutionPolicy Bypass -File webview2/scripts/run.ps1",
    "preview": "vite preview"
  },
  "keywords": [
    "tunnel",
    "localhost",
    "cloudflare",
    "ssh",
    "api-testing",
    "inspector",
    "developer-tools"
  ],
  "author": "Share Port",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.51.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  }
}
